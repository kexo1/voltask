# Lokálna vývojová databáza (číta ju Docker Compose)
POSTGRES_USER=ucm
POSTGRES_PASSWORD=ucm_local_password
POSTGRES_DB=ucm_tasks

# Adresa frontendu povolená pre backend CORS
FRONTEND_URL=http://localhost:5173

# Vygeneruj silny lokálny secret (PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
JWT_SECRET=

# Voliteľné. Webhook URL je tajomstvo; nezdieľaj ju a necommituj.
DISCORD_WEBHOOK_URL=