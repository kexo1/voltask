# BACKEND: číta ho NestJS pri spustení cez npm run start:dev

# Port, na ktorom beží API
PORT=3000

# Používateľ, heslo a názov DB musia sedieť s .env v koreni
DATABASE_URL=postgresql://ucm:zmen-si-heslo@localhost:5432/ucm_tasks

# Adresa frontendu (povolená pre CORS)
FRONTEND_URL=http://localhost:5173

