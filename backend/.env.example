# Pri lokálnom spustení backendu mimo Dockeru skopíruj tento súbor na .env.
PORT=3000

# PostgreSQL URL pre lokálny backend (nie pre backend kontajner).
DATABASE_URL=postgresql://ucm:ucm_local_password@localhost:5432/ucm_tasks?schema=public

# Adresa frontendu povolená pre CORS
FRONTEND_URL=http://localhost:5173

# Voliteľný Discord webhook; nikdy necommituj skutočnú URL.
DISCORD_WEBHOOK_URL=
